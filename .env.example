# Variáveis de ambiente — copie este arquivo para .env.local e preencha os valores.

# URL de conexão com o Postgres usada pelo APP em runtime.
# Local (docker-compose.yml): postgres://postgres:postgres@localhost:5433/financiamento
# CI (service container):      postgres://postgres:postgres@localhost:5432/financiamento
# Produção (Neon, POOLED):     postgresql://<user>:<pass>@ep-<...>-pooler.neon.tech/<db>?sslmode=require
# (porta padrão 5432; a porta 5433 é só do Postgres local via docker-compose)
# Em produção use a string POOLED (host com `-pooler`): o app é um processo Node
# de vida longa com um `pg.Pool`, e o pooler do Neon suporta bem esse padrão.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/financiamento

# Conexão DIRETA do Neon (host SEM `-pooler`), usada SÓ pelas migrações
# (`drizzle.config.ts` e o release step `node scripts/migrate.mjs`). DDL via
# pooler é problemático; se ausente, as migrações caem para `DATABASE_URL`.
# Local/CI: pode ficar vazia (usa o fallback acima).
# Produção (Neon, UNPOOLED): postgresql://<user>:<pass>@ep-<...>.neon.tech/<db>?sslmode=require
DATABASE_URL_UNPOOLED=

# Segredo usado para assinar as sessões JWT do NextAuth.
# Gere um novo com: openssl rand -base64 32
# IMPORTANTE: deve ser ESTÁVEL entre deploys (mesmo valor em preview e produção) —
# se mudar, todas as sessões ativas são invalidadas.
AUTH_SECRET=

# OAuth do Google (login exclusivo em produção; em dev o email/senha também fica ativo).
# Crie as credenciais em https://console.cloud.google.com/apis/credentials
# e configure a callback URL https://SEU-DOMINIO/api/auth/callback/google.
# Em dev local, use http://localhost:3000/api/auth/callback/google.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# URL pública canônica (OPCIONAL no Auth.js v5 — o host é inferido dos headers).
# Se usar, defina https://amortiza.me em produção.
AUTH_URL=
# OBRIGATÓRIO atrás de proxy reverso (Cloudflare proxy + Railway): confia no
# X-Forwarded-Host do proxy. Sem isso, o Auth.js pode rejeitar host/cookies e o
# login quebra. (O Auth.js v5 assume `true` na Vercel e no Cloudflare Pages;
# em Railway/self-host é preciso setar explicitamente.)
AUTH_TRUST_HOST=true

# Provider de pagamentos: fake (dev/CI) | stripe | asaas.
# fake não é permitido em produção (guard lança erro com NODE_ENV=production).
# NODE_ENV é gerenciado pelo Next.js/Vercel — não defina manualmente.
PAYMENT_PROVIDER=fake

# --- Asaas (assinaturas) ---
# ATENÇÃO à pegadinha do `$`: a chave sandbox começa com `$aact_hmlg_` e PRECISA
# ser escrita `\$aact_hmlg_...` AQUI. O `$` é expandido pelo shell E por
# `@next/env`/dotenv-expand; aspas simples/duplas NÃO escapam (o dotenv-expand
# remove as aspas e depois expande o `$`). Sem o `\` a variável chega VAZIA e a
# API responde 401 — mesmo com a chave "presente" no arquivo.
# Mesma regra para a chave de produção `$aact_prod_...`.
ASAAS_ENV=sandbox
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
# Ex.: ASAAS_API_KEY=\$aact_hmlg_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ASAAS_API_KEY=
# Mesmo segredo usado no header `asaas-access-token` do webhook. Mín. 32 chars.
# Gere com: openssl rand -base64 48
ASAAS_WEBHOOK_AUTH_TOKEN=
# Allowlist OPCIONAL de IPs de origem do webhook (CSV). Vazia = não bloqueia por
# IP (default). Em PRODUÇÃO use os 4 IPs oficiais do Asaas:
# 52.67.12.206,18.230.8.159,54.94.136.112,54.94.183.101
# NÃO configure em sandbox (o sandbox envia de IPs extras → 403 nos testes).
ASAAS_WEBHOOK_IP_ALLOWLIST=
# Email que recebe os alertas do webhook no Asaas (script de registro). Só é
# usado por `scripts/register-asaas-webhook.ts`; o app em runtime não lê.
WEBHOOK_ADMIN_EMAIL=
# Base das callback URLs do checkout e do webhook (`${APP_URL}/api/asaas/webhook`).
# Em produção: https://amortiza.me (sem barra final).
APP_URL=http://localhost:3012
# Protege os crons (`/api/cron/reconcile` e `/api/cron/dunning`), via header
# `Authorization: Bearer <CRON_SECRET>`. Gere com: openssl rand -hex 32
CRON_SECRET=

# --- NFS-e automática por assinatura (OPCIONAL, desligada por padrão) ---
# Com ASAAS_INVOICE_ENABLED=false (default) NADA é chamado: nem GET /fiscalInfo/
# nem POST /subscriptions/{id}/invoiceSettings nem upsert de INVOICE_*.
#
# Para habilitar é preciso, ANTES, ter `fiscalInfo` configurado na conta Asaas
# (GET /v3/fiscalInfo responde 200; 404 = conta sem configuração fiscal) e a
# credencial municipal aceita pela prefeitura. Nesta conta o município retornou
# `authenticationType=CERTIFICATE`, que exige um certificado digital A1 — logo a
# feature NÃO é validável em sandbox aqui. Preencha os dados fiscais com o
# contador e só então mude a flag para `true`.
#
# ASAAS_INVOICE_ENABLED=false
# Nome do serviço municipal (obrigatório quando habilitado).
# ASAAS_INVOICE_MUNICIPAL_SERVICE_NAME=
# Identificador do serviço municipal. Municípios que LISTAM serviços
# (GET /v3/fiscalInfo/services) devolvem um `id` — use `..._SERVICE_ID`, que é
# enviado como `municipalServiceId` e tem precedência. Municípios sem lista
# usam o código da prefeitura em `..._SERVICE_CODE` (enviado como
# `municipalServiceCode`). Informe UM dos dois.
# ASAAS_INVOICE_MUNICIPAL_SERVICE_ID=
# ASAAS_INVOICE_MUNICIPAL_SERVICE_CODE=
#
# Com a flag ligada, além da NFS-e automática das assinaturas, cada compra de
# créditos paga (checkout DETACHED) também agenda uma NFS-e via POST /v3/invoices
# (`src/lib/payments/asaas/invoice.ts`). Sem serviço municipal configurado, ou
# fora de produção, nada é emitido — só um aviso no log.
# Quando emitir: ON_PAYMENT_CONFIRMATION (default) | ON_PAYMENT_DUE_DATE |
# BEFORE_PAYMENT_DUE_DATE | ON_DUE_DATE_MONTH | ON_NEXT_MONTH
# ASAAS_INVOICE_EFFECTIVE_PERIOD=ON_PAYMENT_CONFIRMATION
# Impostos (números em %; RETAIN_ISS é `true`/`false`).
# ASAAS_INVOICE_RETAIN_ISS=false
# ASAAS_INVOICE_ISS=0
# ASAAS_INVOICE_PIS=0
# ASAAS_INVOICE_COFINS=0
# ASAAS_INVOICE_CSLL=0
# ASAAS_INVOICE_INSS=0
# ASAAS_INVOICE_IR=0
# Opcionais (códigos fiscais; deixe vazio para omitir do body).
# ASAAS_INVOICE_NBS_CODE=
# ASAAS_INVOICE_TAX_SITUATION_CODE=
# ASAAS_INVOICE_TAX_CLASSIFICATION_CODE=
# ASAAS_INVOICE_OPERATION_INDICATOR_CODE=
# ASAAS_INVOICE_OBSERVATIONS=

# --- E-mail transacional (Resend) -------------------------------------------
# Usado pelo cron de dunning (`/api/cron/dunning`) para avisar o assinante
# inadimplente durante a carência. Fail-closed: sem EMAIL_ENABLED=true E
# RESEND_API_KEY E EMAIL_FROM, o cron não envia nada (só log).
# EMAIL_ENABLED=false
# Chave criada em resend.com/api-keys (permissão de envio).
# RESEND_API_KEY=
# Remetente: precisa usar um domínio verificado no Resend (DNS próprio).
# EMAIL_FROM=amortiza.me <financeiro@amortiza.me>
# Opcional; aparece como "responder para" no e-mail do cliente.
# EMAIL_REPLY_TO=contato@amortiza.me
